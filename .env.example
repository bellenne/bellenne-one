BELLENNE_PORT=17863
APP_SECRET_KEY=generate-a-long-random-secret
CREDENTIALS_ENCRYPTION_KEY=
TIMEZONE=Europe/Moscow
SECURE_COOKIES=false
LOG_LEVEL=INFO

DEMO_MODE=true
SEED_DEMO_DATA=true
PULSE_SCHEDULER_ENABLED=true

# Keep Echo in dry-run until templates and cabinet access are verified.
ECHO_DRY_RUN=true

WB_HTTP_TIMEOUT_SECONDS=30
WB_REQUEST_INTERVAL_SECONDS=20.2
WB_INFO_REQUEST_INTERVAL_SECONDS=0.22

NEST_API_DOCS_ENABLED=false
PROOF_API_DOCS_ENABLED=false
PROOF_NOTIFICATION_ASYNC=true
MATTERMOST_HTTP_TIMEOUT_SECONDS=10
PROOF_PUBLIC_BASE_URL=https://one.customcraft-mes.ru

# BellenneFolio uses the same numeric user ID received from Bellenne auth.
FOLIO_ADMIN_USER_ID=1
# Optional Fernet key. If empty, Folio creates credentials.key in folio_data.
FOLIO_ENCRYPTION_KEY=
FOLIO_WORKER_IDLE_SECONDS=1
# Optional transport override. If empty, the HTTP client library default is used.
FOLIO_OZON_HTTP_TIMEOUT_SECONDS=
# Таймаут запросов Folio Worker к RetailCRM.
FOLIO_RETAILCRM_HTTP_TIMEOUT_SECONDS=20
